<?xml version="1.0" encoding="UTF-8"?>
<!-- Universal Logger - LIMS 프로젝트 설정 (XML 버전) -->
<configuration>
    <!-- 전역 설정 -->
    <global>
        <appName>bioChem</appName>
        <timezone>Asia/Seoul</timezone>
    </global>

    <!-- 로그 레벨 -->
    <levels>
        <root>INFO</root>
        <logger name="lims">DEBUG</logger>
        <logger name="rdms">DEBUG</logger>
    </levels>

    <!-- 출력 설정 -->
    <outputs>
        <!-- 콘솔 출력 -->
        <console>
            <enabled>true</enabled>
            <level>DEBUG</level>
            <format>[{timestamp}] [{level}] [{thread}] [{logger}:{line}] - {message}</format>
            <colors>
                <DEBUG>cyan</DEBUG>
                <INFO>green</INFO>
                <WARN>yellow</WARN>
                <ERROR>red</ERROR>
            </colors>
        </console>

        <!-- 일반 로그 파일 -->
        <file>
            <enabled>true</enabled>
            <level>DEBUG</level>
            <path>C:/logs/Lims/{appName}_logs.{date}.log</path>
            <format>[{timestamp}] [{level}] [{thread}] [{logger}:{line}] - {message}</format>
            <rotation>
                <maxFileSize>50MB</maxFileSize>
                <maxFiles>30</maxFiles>
                <compress>true</compress>
            </rotation>
        </file>

        <!-- 에러 전용 파일 -->
        <errorFile>
            <enabled>true</enabled>
            <level>ERROR</level>
            <path>C:/logs/Lims/error/{appName}_errlogs.{date}.log</path>
            <format>[{timestamp}] [{level}] [{thread}] [{logger}:{line}] - {message}</format>
            <rotation>
                <maxFileSize>50MB</maxFileSize>
                <maxFiles>30</maxFiles>
                <compress>true</compress>
            </rotation>
        </errorFile>

        <!-- 데이터베이스 로깅 (선택 사항) -->
        <database>
            <enabled>false</enabled>  <!-- 사용 시 true로 변경 -->
            <level>INFO</level>
            <database>
                <type>mysql</type>
                <host>localhost</host>
                <port>3306</port>
                <database>lims_logs</database>
                <table>app_logs</table>
                <username>logger_user</username>
                <password>your_password</password>
            </database>
        </database>
    </outputs>
</configuration>
