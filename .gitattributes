# Set default behavior to automatically normalize line endings
* text=auto

# Shell scripts must use LF line endings (Unix/macOS)
*.sh text eol=lf

# Batch files must use CRLF line endings (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Java source files
*.java text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
